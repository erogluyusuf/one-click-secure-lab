version: '3.8'

services:
  wireguard:
    image: lscr.io/linuxserver/wireguard:latest
    container_name: wireguard
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Istanbul
      - SERVERURL=auto
      - SERVERPORT=51820
      - PEERS=2
      - PEERDNS=10.10.10.3
    ports:
      - "51820:51820/udp"
    volumes:
      - /opt/secure-lab/wireguard:/config
      - /lib/modules:/lib/modules
    restart: unless-stopped
    networks:
      secure_lab_net:
        ipv4_address: 10.10.10.2

  pihole:
    image: pihole/pihole:latest
    container_name: pihole
    environment:
      - TZ=Europe/Istanbul
      - WEBPASSWORD=secure_admin_123
    ports:
      - "53:53/tcp"
      - "53:53/udp"
      - "8080:80/tcp"
    volumes:
      - /opt/secure-lab/pihole/etc:/etc/pihole
      - /opt/secure-lab/pihole/dnsmasq:/etc/dnsmasq.d
    restart: unless-stopped
    networks:
      secure_lab_net:
        ipv4_address: 10.10.10.3

  suricata:
    image: jasonish/suricata:latest
    container_name: suricata
    network_mode: "host"
    cap_add:
      - NET_ADMIN
      - NET_RAW
      - SYS_NICE
    volumes:
      - /opt/secure-lab/suricata/logs:/var/log/suricata
      - /opt/secure-lab/suricata/etc:/etc/suricata
    command: -i eth0
    restart: unless-stopped

networks:
  secure_lab_net:
    external: true
    name: secure-lab-network
